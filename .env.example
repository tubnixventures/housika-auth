# Housika Authentication Backend Environment Variables & Secrets

# Cloudflare Environment & App Configuration
ENVIRONMENT="development"
APP_URL="https://auth.housika.co.ke"
BCRYPT_ROUNDS="10"

# Mandatory Cryptographic Secrets (Wrangler Secret in production)
JWT_ACCESS_SECRET="housika_jwt_access_super_secret_key_minimum_32_chars"
JWT_REFRESH_SECRET="housika_jwt_refresh_super_secret_key_minimum_32_chars"
CHALLENGE_HMAC_SECRET="housika_challenge_hmac_secret_key_min_32_characters"

# ZeptoMail (Zoho) Transactional Email Service
ZEPTOMAIL_API_KEY="Zoho-enczapikey_sample_key_here"
ZEPTOMAIL_FROM_ADDRESS="accounts@housika.co.ke"
ZEPTOMAIL_FROM_NAME="Housika Accounts"

# Infobip SMS & WhatsApp Notification Service
INFOBIP_API_KEY="App_sample_infobip_key_here"
INFOBIP_BASE_URL="https://xyz123.api.infobip.com"
INFOBIP_WHATSAPP_NUMBER="447111111111"

# Google OAuth 2.0 Client ID for Token Verification
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
